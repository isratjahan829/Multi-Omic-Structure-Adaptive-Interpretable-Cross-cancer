{
  "data": {
    "root": "./data_pan",
    "cohorts": [
      "ACC",
      "BLCA",
      "BRCA",
      "CESC",
      "CHOL",
      "COADREAD",
      "DLBC",
      "ESCA",
      "GBM",
      "HNSC",
      "KICH",
      "KIRC",
      "KIRP",
      "LAML",
      "LGG",
      "LIHC",
      "LUAD",
      "LUSC",
      "MESO",
      "OV",
      "PAAD",
      "PCPG",
      "PRAD",
      "SARC",
      "SKCM",
      "STAD",
      "TGCT",
      "THCA",
      "THYM",
      "UCEC",
      "UCS",
      "UVM"
    ],
    "file_template": "{cohort}_merged_full.csv",
    "omic_prefixes": {
      "mut": [
        "MUT_"
      ],
      "cna": [
        "CNA_"
      ],
      "exp": [
        "RNA_",
        "EXP_",
        "MRNA_",
        "GEXP_"
      ],
      "met": [
        "METH_",
        "MET_"
      ]
    },
    "n_genes_per_block": 100,
    "max_genes": 200,
    "min_mut_freq": 0.02,
    "var_quantile": 0.5,
    "clinical_numeric": [
      "AGE",
      "ANEUPLOIDY_SCORE",
      "TMB_NONSYNONYMOUS",
      "MSI_SCORE_MANTIS",
      "MSI_SENSOR_SCORE",
      "TBL_SCORE",
      "WEIGHT"
    ],
    "clinical_categorical": [
      "SEX",
      "RACE",
      "GRADE",
      "AJCC_PATHOLOGIC_TUMOR_STAGE",
      "PATH_T_STAGE",
      "PATH_N_STAGE",
      "PATH_M_STAGE",
      "HISTORY_NEOADJUVANT_TRTYN",
      "RADIATION_THERAPY"
    ],
    "id_col": "PATIENT_ID",
    "sample_col": "SAMPLE_ID",
    "cohort_col": "CANCER_TYPE_ACRONYM",
    "survival_endpoint": "OS",
    "class_target": "cohort",
    "ppi_edgelist": null,
    "pathway_gmt": null,
    "cache_dir": "./cache"
  },
  "graph": {
    "gene_graph_mode": "hybrid",
    "gene_knn": 12,
    "gene_corr_floor": 0.15,
    "n_relations": 3,
    "n_modules": 64,
    "module_min_size": 5,
    "patient_knn": 10,
    "graph_learner_heads": 4,
    "graph_learner_temp": 0.2,
    "inductive_anchors": true
  },
  "model": {
    "gene_hidden": 64,
    "gene_layers": 3,
    "gene_heads": 4,
    "module_hidden": 128,
    "patient_hidden": 128,
    "patient_layers": 2,
    "clinical_hidden": 32,
    "z_shared": 96,
    "z_specific": 32,
    "dropout": 0.4,
    "edge_dropout": 0.2,
    "n_survival_bins": 12,
    "class_head_source": "auto",
    "survival_head_source": "shared",
    "clinical_residual": true,
    "use_gene_graph": true,
    "use_module_pool": true,
    "use_patient_graph": true,
    "use_disentangle": true,
    "use_cross_omic_contrast": true,
    "use_clinical": true
  },
  "loss": {
    "w_class": 1.0,
    "w_cox": 1.0,
    "w_hazard": 0.5,
    "w_adversarial": 0.3,
    "w_cohort": 0.3,
    "w_orthogonal": 0.1,
    "w_contrast": 0.2,
    "w_graph_reg": 0.05,
    "contrast_temp": 0.1,
    "label_smoothing": 0.1
  },
  "train": {
    "epochs": 20,
    "lr": 0.001,
    "weight_decay": 0.001,
    "gene_dropout": 0.15,
    "input_noise": 0.05,
    "swa": true,
    "swa_start_frac": 0.6,
    "eval_every": 5,
    "batch_size": 32,
    "full_batch": false,
    "patience": 40,
    "grl_warmup": 30,
    "seed": 42,
    "device": "cpu",
    "amp": true,
    "outer_folds": 5,
    "inner_folds": 3,
    "n_repeats": 1,
    "mc_dropout_samples": 30,
    "out_dir": "runs_pan_cohort"
  },
  "tag": "cohort"
}